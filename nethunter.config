################################################################
# NetHunter / USB-arsenal fragment for fleur (kernel 4.14)
# Applied via scripts/kconfig/merge_config.sh over fleur_defconfig
################################################################

# --- modules support (external .ko loading) ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION=""
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set

# --- identify unknown USB devices in dmesg (VID:PID) ---
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# --- USB storage ---
CONFIG_USB_STORAGE=y
CONFIG_UAS=m

# --- USB network (LTE modems, tethering, USB-LAN) ---
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_SUBSET=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_WDM=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_SMSC75XX=m
CONFIG_USB_NET_SMSC95XX=m

# --- USB serial (Arduino, GPS, device consoles) ---
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_SIERRA=m

# --- HID host (USB keyboards/mice via OTG) ---
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# --- audio / video ---
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# --- Bluetooth dongles ---
CONFIG_BT_HCIBTUSB=m

# --- parent menus (stock fleur_defconfig lacks generic netdev/wlan menus) ---
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_BT=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_SCSI=y

# --- Wi-Fi: in-tree drivers (monitor mode capable) ---
# MAC80211 as MODULE: ROM kernel lacks it; cfg80211=y is built-in there
CONFIG_MAC80211=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_MT7601U=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_RT2X00=y
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_ZD1211RW=m

# --- USB gadget functions (NetHunter attacks) ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_F_ACC=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y

# --- wireless core (stock MTK defconfig has no cfg80211/mac80211 chain) ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=y

# --- disable stack protector (its 4.14 prepare-check fails under clang) ---
# CONFIG_CC_STACKPROTECTOR_STRONG is not set
# CONFIG_CC_STACKPROTECTOR is not set
